#include <Sparkfun_DRV2605L.h>
#include <Wire.h>

SFE_HMD_DRV2605L HMD;

void wr(uint8_t reg, uint8_t val) { HMD.writeDRV2605L(reg, val); }
uint8_t rd(uint8_t reg)           { return HMD.readDRV2605L(reg); }

// Play one library effect, wait for it to finish (cancel if it runs too long)
void playEffect(uint8_t effect) {
  wr(0x04, effect);        // sequencer slot 0 = the effect
  wr(0x05, 0);             // slot 1 = 0 means "stop after slot 0"
  wr(0x0C, 0x01);          // GO

  unsigned long t = millis();
  while (rd(0x0C) & 0x01) {
    if (millis() - t > 1500) {   // effect 118 never ends on its own
      wr(0x0C, 0x00);            // cancel
      break;
    }
    delay(5);
  }
}

void setup() {
  Serial.begin(9600);
  HMD.begin();
  delay(10);
  wr(0x01, 0x80);  delay(10);    // reset to defaults

  // ---- try auto-calibration once ----
  wr(0x01, 0x07);                // calibration mode
  wr(0x16, 70);                  // rated voltage ~1.79 Vrms
  wr(0x17, 87);                  // clamp ~1.85 V
  wr(0x1A, 0xAA);                // LRA, brake 3x, loop gain high
  wr(0x1B, 0x90);                // startup boost + drive time 2.1 ms
  wr(0x1E, 0x30);                // longest cal time
  wr(0x0C, 0x01);                // GO
  unsigned long t = millis();
  while (rd(0x0C) & 0x01 && millis() - t < 3000) delay(10);

  uint8_t s = rd(0x00);
  Serial.print("Cal status: 0x"); Serial.println(s, HEX);
  Serial.print("A_CAL_COMP: ");   Serial.println(rd(0x18));
  Serial.print("A_CAL_BEMF: ");   Serial.println(rd(0x19));
  Serial.println((s & 0x08) ? "AUTO-CAL FAILED (playing anyway)" : "AUTO-CAL PASSED");

  // ---- switch to normal playback ----
  wr(0x01, 0x00);                // internal trigger mode, out of standby
  wr(0x03, 6);                   // LRA library
  Serial.println("Starting effects...\n");
}

void loop() {
  for (uint8_t effect = 1; effect <= 123; effect++) {
    Serial.print("Effect "); Serial.println(effect);
    playEffect(effect);
    delay(600);                  // short pause so you can tell them apart
  }
  Serial.println("--- done, restarting in 3 s ---\n");
  delay(3000);
}