<?xml version="1.0"?>
<!-- robot_dimensions.xacro
     Single source of truth for every dimension, mass and offset.
     Change numbers here; nothing else needs touching. Units: meters, kilograms, radians. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

   <!-- Base chassis (forward is +x) -->
   <xacro:property name="base_length" value="0.44"/>   <!-- x -->
   <xacro:property name="base_width"  value="0.36"/>   <!-- y -->
  <xacro:property name="base_height" value="0.048"/>   <!-- z -->
  <xacro:property name="base_mass"   value=".846"/>
  <xacro:property name="ground_clearance" value="0.024"/> <!-- bottom of chassis to floor -->

  <!-- Drive wheels -->
  <xacro:property name="wheel_radius" value="0.096"/>
  <xacro:property name="wheel_width"  value="0.032"/>
  <xacro:property name="wheel_mass"   value="0.142"/>
   <!-- Sidewalls meet the chassis sides; tire radius reaches the front/rear edges. -->
   <xacro:property name="wheel_offset_x" value="${base_length/2 - wheel_radius}"/>
   <xacro:property name="wheel_offset_y" value="${base_width/2 + wheel_width/2}"/>

  <!-- Lidar -->
  <xacro:property name="laser_radius" value="0.055"/>
  <xacro:property name="laser_height" value="0.046"/>
  <xacro:property name="laser_mass"   value="0.11"/>
  <!-- Lidar position -->
     <xacro:property name="laser_x" value="0.12"/>
     <xacro:property name="laser_y" value="0.0"/>
     <xacro:property name="laser_z" value="${base_z_offset + base_height + 0.393}"/>

  <!-- IMU (small cube) -->
  <xacro:property name="imu_size" value="0.055"/>
  <xacro:property name="imu_mass" value="0.05"/>
   <!-- position in the base_link frame: centred on chassis, mid-height. Change to match real mounting -->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="${base_z_offset + base_height}"/>

  <!-- Derived: base_link frame sits at axle height, so the footprint->base_link
       transform is exactly one wheel radius. The chassis box is shifted up
       inside base_link so it clears the ground. -->
  <xacro:property name="base_z_offset"
                  value="${ground_clearance + base_height/2 - wheel_radius}"/>

</robot>
